# ============================================================
# meng-lovespace 根目录忽略规则
# 合并自远端 Initial commit 的 .gitignore 与各子项目原有规则
# ============================================================

# ---------- Java / Maven ----------
**/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
*.ctxt
.mtj.tmp/
logs/
*.log
uploads/

# 本机环境产物（含绝对路径的 Maven classpath 清单）
cp.txt

# ---------- 本地配置 / 环境变量 ----------
**/application-local.yml
**/application-local.yaml
**/application-local.properties
.env
.env.local
.env.*.local
!.env.example

# ---------- Node / 前端 ----------
**/node_modules/
dist/
dist-ssr/
build/
coverage/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- IDE / 编辑器 ----------
.idea/
**/.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- 工具 / 临时文件 ----------
.workbuddy/
*.tmp
*~
